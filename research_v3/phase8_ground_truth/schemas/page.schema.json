{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExaminationPageSchema",
  "description": "Schema for physical examination scanned page image records",
  "type": "object",
  "required": [
    "student_id",
    "page_id",
    "page_index",
    "image_relative_path",
    "image_sha256",
    "width_px",
    "height_px",
    "physical_dpi",
    "scan_quality_tags"
  ],
  "properties": {
    "student_id": {
      "type": "string",
      "pattern": "^s([1-9]|[1-2][0-9]|3[0-7])$"
    },
    "page_id": {
      "type": "string",
      "pattern": "^s([1-9]|[1-2][0-9]|3[0-7])_p[0-9]{2}$"
    },
    "page_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15
    },
    "image_relative_path": {
      "type": "string",
      "description": "Relative path to raw scanned page JPEG"
    },
    "image_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "width_px": {
      "type": "integer",
      "enum": [3072, 4096]
    },
    "height_px": {
      "type": "integer",
      "enum": [3072, 4096]
    },
    "physical_dpi": {
      "type": "number",
      "description": "True EXIF header DPI metadata value (e.g. 72.0)"
    },
    "scan_quality_tags": {
      "type": "string",
      "description": "Semicolon-delimited descriptive tags for image content"
    }
  },
  "additionalProperties": false
}
